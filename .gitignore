# Per-run raw outputs are published as compressed release assets, not in git.
results/**/runs/
*.npz
*.npz.tmp
*.tmp
__pycache__/
*.pyc
.pytest_cache/
# LaTeX build files
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/latexmk.out
paper/*.synctex.gz

# v12 derived mouse data (small; raw NWB files are downloaded from the Allen S3 bucket)
!invivo/processed/*.npz
paper_v12/*.aux
paper_v12/*.bbl
paper_v12/*.blg
paper_v12/*.log
paper_v12/*.out
paper_v12/bib.out
paper_v12/pdflatex.out
